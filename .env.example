# Weather Analytics & Intelligence Platform - Environment Variables
# Copy this file to .env.local for local development.

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Public project URL (Accessible by browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (Safe for browser client operations)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Private service role key (SERVER-SIDE ONLY - Never expose to browser or commit)
# Used by Next.js Route Handlers and Vercel Cron to write historical weather
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# Automation & Security
# ==============================================================================
# Secret key used by Vercel Cron to authorize automated collection requests
# Format: Generate a random 32+ character string
CRON_SECRET=your_secure_cron_secret_here

# ==============================================================================
# Weather Provider (Optional)
# ==============================================================================
# Open-Meteo does not require an API key for standard usage.
# If using a commercial Open-Meteo plan:
# WEATHER_API_KEY=
